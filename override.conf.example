# Example systemd drop-in configuration for theater-mode.service.
#
# To apply custom settings, run:
#   systemctl --user edit theater-mode.service
#
# This creates ~/.config/systemd/user/theater-mode.service.d/override.conf and
# reloads the systemd manager configuration. Only include variables you wish
# to override; omitted variables will use defaults from theater-mode.service.
#
# Full documentation is available in README.md.

[Service]

# Active effect: 'dim' (Wayland fade with game artwork) or 'log' (dry run).
Environment=THEATER_EFFECT=dim

# Fraction of secondary display brightness to reduce (0.0 to 1.0; higher is darker).
# When artwork is enabled, this scales artwork image brightness directly.
Environment=THEATER_DIM_FACTOR=0.85

# Duration of the fade transition in seconds.
Environment=THEATER_DIM_DURATION=2.0

# Easing curve for fades: sine | quad | cubic | linear
Environment=THEATER_DIM_CURVE=sine

# Artwork display on secondary screens: --art (show game artwork) | --no-art (flat black)
Environment=THEATER_ART=--art

# Stability delay (seconds) before following a game to a new display.
Environment=THEATER_STAGE_DELAY=1.5

# Grace period (seconds) before restoring displays after game windows close (0 disables).
Environment=THEATER_REVERT_DELAY=3

# Uncomment to enable verbose debug logging for all window events.
# Environment=THEATER_VERBOSE=--verbose
