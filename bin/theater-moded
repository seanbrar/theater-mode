#!/usr/bin/env python3
"""
theater-moded — decides when a Steam game is on screen, and what to do about it.

The KWin script (theater-detect) reports raw window lifecycle over D-Bus. This
daemon holds all the policy: whether a window is a Steam game, which output it
is on, and what effect to apply to the other outputs. Keeping it here means the
interesting logic is inspectable, restartable, and testable without touching the
compositor.

Effects are pluggable and default to a dry run, so the detector can be watched
against real games before anything starts changing the display.
"""

from __future__ import annotations

import argparse
import glob
import json
import logging
import os
import re
import signal
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path

import gi

gi.require_version("Gio", "2.0")
gi.require_version("GLibUnix", "2.0")
from gi.repository import Gio, GLib, GLibUnix  # noqa: E402

BUS_NAME = "org.theatermode.TheaterMode"
OBJECT_PATH = "/org/theatermode/TheaterMode"
INTERFACE = "org.theatermode.TheaterMode"

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "theater-mode"
STATE_FILE = STATE_DIR / "pending.json"

# Every argument coming from the KWin script is a string, including numbers and
# booleans. KWin's callDBus infers D-Bus types from JavaScript values and cannot
# produce a uint32 or a reliable boolean, and a type mismatch is rejected by the
# bus before the daemon ever sees the call — a silent failure. Strings marshal
# unambiguously, so the boundary uses them and this daemon does the parsing.
INTERFACE_XML = f"""
<node>
  <interface name='{INTERFACE}'>
    <method name='WindowOpened'>
      <arg type='s' name='window_id' direction='in'/>
      <arg type='s' name='resource_class' direction='in'/>
      <arg type='s' name='pid' direction='in'/>
      <arg type='s' name='output' direction='in'/>
      <arg type='s' name='fullscreen' direction='in'/>
      <arg type='s' name='normal' direction='in'/>
    </method>
    <method name='WindowChanged'>
      <arg type='s' name='window_id' direction='in'/>
      <arg type='s' name='output' direction='in'/>
      <arg type='s' name='fullscreen' direction='in'/>
    </method>
    <method name='WindowClosed'>
      <arg type='s' name='window_id' direction='in'/>
    </method>
    <method name='SnapshotBegin'/>
    <method name='SnapshotEnd'/>
    <method name='Status'>
      <arg type='s' name='status_json' direction='out'/>
    </method>
    <method name='Simulate'>
      <arg type='s' name='appid' direction='in'/>
      <arg type='s' name='output' direction='in'/>
      <arg type='s' name='result' direction='out'/>
    </method>
    <method name='Clear'>
      <arg type='s' name='result' direction='out'/>
    </method>
  </interface>
</node>
"""

log = logging.getLogger("theater-moded")


# --------------------------------------------------------------------------
# Deciding what counts as a game
# --------------------------------------------------------------------------

STEAM_APP_CLASS = re.compile(r"^steam_app_(\d+)$")
STEAM_LAUNCH_ARG = re.compile(r"\bAppId=(\d+)\b")

# The Steam client, its helper processes and desktop-shell surfaces all inherit
# or carry Steam environment variables, so they must be excluded by name before
# the environment is consulted. Big Picture is class "steam" and is caught here.
IGNORED_CLASSES = frozenset(
    {
        "steam",
        "steamwebhelper",
        "steamdeckgyrodsu",
        "plasmashell",
        "xwaylandvideobridge",
        "org.kde.plasmashell",
    }
)


def steam_appid_for_window(resource_class: str, pid: int) -> str | None:
    """Return the Steam AppID this window belongs to, or None.

    Proton and most native titles get a WM_CLASS of steam_app_<appid>, which is
    both the cheapest and the most specific signal available. Anything else that
    Steam launched is identified by the SteamGameId it inherits, which also
    covers native games that set their own class.
    """
    if resource_class in IGNORED_CLASSES:
        return None

    match = STEAM_APP_CLASS.match(resource_class)
    if match:
        return match.group(1)

    environ = read_process_environ(pid)
    for key in ("SteamGameId", "SteamAppId"):
        value = environ.get(key, "")
        if value.isdigit() and int(value) > 0:
            return value

    # A game run inside gamescope is invisible to the compositor — KWin only
    # sees gamescope's own surface, and gamescope is launched *before* Steam
    # injects SteamGameId, so its environment has nothing. The AppID is still
    # right there in its command line, because Steam passes it as an argument
    # to reaper: "... reaper SteamLaunch AppId=1222140 -- ... proton ...".
    match = STEAM_LAUNCH_ARG.search(read_process_cmdline(pid))
    if match and int(match.group(1)) > 0:
        return match.group(1)
    return None


def parse_bool(value: str) -> bool:
    return str(value).strip().lower() == "true"


def parse_int(value: str) -> int:
    try:
        return int(str(value).strip())
    except ValueError:
        return 0


def read_process_cmdline(pid: int) -> str:
    """A process's argv as one space-joined string, or empty if unreadable."""
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except (OSError, ValueError):
        return ""
    return " ".join(part.decode("utf-8", "replace") for part in raw.split(b"\0") if part)


def read_process_environ(pid: int) -> dict[str, str]:
    """Read a process's environment, tolerating races and permission errors.

    Proton games run inside pressure-vessel, which uses mount namespaces rather
    than PID namespaces, so /proc/<pid>/environ stays readable from the session.
    """
    try:
        raw = Path(f"/proc/{pid}/environ").read_bytes()
    except (OSError, ValueError):
        return {}

    environ = {}
    for entry in raw.split(b"\0"):
        if not entry:
            continue
        key, _, value = entry.partition(b"=")
        environ[key.decode("utf-8", "replace")] = value.decode("utf-8", "replace")
    return environ


# --------------------------------------------------------------------------
# Talking to the compositor about outputs
# --------------------------------------------------------------------------


def connected_outputs() -> set[str]:
    """Names of every connected output, read straight from DRM.

    Cheap enough to call on every window event, which is why this is kept
    separate from brightness discovery below — that one shells out.
    """
    outputs = set()
    for connector in glob.glob("/sys/class/drm/card*-*"):
        path = Path(connector)
        try:
            if path.joinpath("status").read_text().strip() != "connected":
                continue
        except OSError:
            continue
        # /sys/class/drm/card1-DP-1 -> DP-1
        outputs.add(path.name.split("-", 1)[1] if "-" in path.name else path.name)
    return outputs


def output_brightness() -> dict[str, float | None]:
    """Current per-output brightness as KWin sees it: 0.0-1.0, or None.

    None means the output has no brightness control of any kind — typically a
    monitor whose DDC/CI handshake failed. Those get reported and skipped, so a
    half-applied effect shows up in the log instead of looking like a bug.
    """
    try:
        raw = subprocess.run(
            ["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=10, check=True
        ).stdout
        data = json.loads(raw)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as exc:
        log.warning("could not query kscreen for brightness: %s", exc)
        return {}
    return {o["name"]: o.get("brightness") for o in data.get("outputs", []) if o.get("name")}


def set_output_brightness(levels: dict[str, int]) -> bool:
    """Set several outputs' brightness at once, as integer percentages.

    Batched deliberately. kscreen-doctor applies everything in one invocation
    atomically, and one invocation costs about the same as one output's worth
    (~100 ms for three outputs vs ~80 ms for one). Calling it per output would
    both stagger the monitors visibly — they would ramp one after another — and
    double the number of display-configuration changes KWin has to process
    mid-fade, which is felt as input stutter.

    Deliberately routed through kscreen rather than org.kde.ScreenBrightness.
    Both drive the identical control, but powerdevil additionally calls
    plasmashell's osdService, which pops the brightness OSD over the game;
    kscreen turns the same knob silently.

    The value must be a whole number: kscreen-doctor uses "." as its argument
    separator, so "0.5" parses as "0" and blacks the screen out entirely.
    """
    if not levels:
        return True
    args = [
        f"output.{output}.brightness.{max(0, min(100, int(percent)))}"
        for output, percent in sorted(levels.items())
    ]
    try:
        subprocess.run(
            ["kscreen-doctor", *args], capture_output=True, timeout=10, check=True
        )
        return True
    except (OSError, subprocess.SubprocessError) as exc:
        log.error("could not set brightness on %s: %s", ", ".join(sorted(levels)), exc)
        return False


# --------------------------------------------------------------------------
# Effects
# --------------------------------------------------------------------------


class Effect:
    """An effect applied to the outputs a game is *not* on."""

    name = "none"
    # How long this effect takes to play out. Zero means it happens at once,
    # which is what lets a composite schedule the abrupt effects for the moment
    # the gradual ones have made the screens darkest.
    transition_seconds = 0.0

    def apply(self, game_output: str, other_outputs: list[str], appid: str) -> None:
        raise NotImplementedError

    def revert(self, immediate: bool = False) -> None:
        raise NotImplementedError

    def cancel_pending(self) -> None:
        """Drop any queued-but-unapplied work. Does not undo what is applied."""

    def recover(self, saved: dict) -> None:
        """Undo an effect left behind by a previous, crashed run."""

    def saved_state(self) -> dict | None:
        """State needed to revert if this process dies. None if nothing to undo."""
        return None


class LogEffect(Effect):
    """Dry run: reports what would happen and touches nothing."""

    name = "log"

    def apply(self, game_output: str, other_outputs: list[str], appid: str) -> None:
        log.info(
            "DRY RUN: would apply theater mode for appid %s — game on %s, would affect %s",
            appid,
            game_output,
            ", ".join(other_outputs) or "(no other outputs)",
        )

    def revert(self, immediate: bool = False) -> None:
        log.info("DRY RUN: would revert theater mode")


class BrightnessEffect(Effect):
    """Dims the other outputs, and restores them when the game exits.

    Deliberately a single write per transition, with no software ramp.

    KWin queues DDC/CI writes and only pushes them to the monitor after roughly
    a second and a half. In testing: setting 30%% left the panel reporting 75%%
    at t+0.8s and 30%% at t+1.7s. A software fade therefore cannot
    work — every intermediate value is discarded, so the screen sits still and
    then jumps — and it is actively harmful, because a stale queued value can
    land *after* the final one and flash the monitor to the wrong level on the
    way back up. Writing the target once lets the monitor perform its own
    internal ramp, which is what actually looks smooth.

    The baseline — what "undimmed" means for each output — is captured once and
    held until a restore has finished, so a game that flickers between windows
    during startup cannot ratchet the monitors progressively darker.
    """

    name = "brightness"

    def __init__(self, dim_factor: float, settle_seconds: float = 1.5):
        self._dim_factor = dim_factor
        # How long a brightness change takes to actually reach the glass. Not a
        # fade: it is the compositor's write delay plus the panel's own ramp,
        # and it exists so a composite can time abrupt effects against it.
        self.transition_seconds = settle_seconds
        self._baseline: dict[str, int] = {}

    def apply(self, game_output: str, other_outputs: list[str], appid: str) -> None:
        levels = output_brightness()
        targets: dict[str, int] = {}

        for output in other_outputs:
            if output not in self._baseline:
                current = levels.get(output)
                if current is None:
                    log.info("output %s has no brightness control; leaving it alone", output)
                    continue
                self._baseline[output] = int(round(current * 100))
            targets[output] = max(1, int(self._baseline[output] * self._dim_factor))

        if not targets:
            log.warning("theater mode active but nothing could be dimmed")
            return

        # An output with a baseline that is not a target is one the game just
        # moved on to; it goes back to normal in the same write.
        for output, base in self._baseline.items():
            targets.setdefault(output, base)

        log.info(
            "dimming %s",
            ", ".join(
                f"{o} {self._baseline[o]}%->{t}%" for o, t in sorted(targets.items())
            ),
        )
        set_output_brightness(targets)

    def revert(self, immediate: bool = False) -> None:
        if not self._baseline:
            return
        targets = dict(self._baseline)
        self._baseline.clear()
        log.info("restoring %s", ", ".join(f"{o} -> {v}%" for o, v in sorted(targets.items())))
        set_output_brightness(targets)

    def saved_state(self) -> dict | None:
        return {"brightness_percent": dict(self._baseline)} if self._baseline else None

    def recover(self, saved: dict) -> None:
        values = saved.get("brightness_percent") or {}
        if not values:
            return
        log.warning("restoring brightness left behind by a previous run: %s", values)
        set_output_brightness({output: int(value) for output, value in values.items()})


# --------------------------------------------------------------------------
# Wallpapers
# --------------------------------------------------------------------------

STEAM_LIBRARY_CACHE = Path.home() / ".local/share/Steam/appcache/librarycache"
ART_CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "theater-mode"
IMAGE_PLUGIN = "org.kde.image"


def plasma_evaluate(script: str) -> str | None:
    """Run a Plasma shell script and return whatever it printed.

    Per-screen wallpapers are only reachable this way: plasma-apply-wallpaperimage
    sets every screen at once, and the containment config is not safe to edit on
    disk while plasmashell is running.
    """
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        result = bus.call_sync(
            "org.kde.plasmashell",
            "/PlasmaShell",
            "org.kde.PlasmaShell",
            "evaluateScript",
            GLib.Variant("(s)", (script,)),
            GLib.VariantType("(s)"),
            Gio.DBusCallFlags.NONE,
            20000,
            None,
        )
        return result.unpack()[0]
    except GLib.Error as exc:
        log.error("Plasma script failed: %s", exc.message)
        return None


def output_positions() -> dict[str, tuple[int, int]]:
    """Top-left position of every output, keyed by connector name."""
    try:
        raw = subprocess.run(
            ["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=10, check=True
        ).stdout
        data = json.loads(raw)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as exc:
        log.warning("could not query kscreen for output positions: %s", exc)
        return {}

    positions = {}
    for output in data.get("outputs", []):
        pos = output.get("pos") or {}
        if output.get("name") and "x" in pos and "y" in pos:
            positions[output["name"]] = (int(pos["x"]), int(pos["y"]))
    return positions


def output_sizes() -> dict[str, tuple[int, int]]:
    """Physical pixel size of every output, for rendering art at native resolution."""
    try:
        raw = subprocess.run(
            ["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=10, check=True
        ).stdout
        data = json.loads(raw)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as exc:
        log.warning("could not query kscreen for output sizes: %s", exc)
        return {}

    sizes = {}
    for output in data.get("outputs", []):
        size = output.get("size") or {}
        if output.get("name") and size.get("width") and size.get("height"):
            sizes[output["name"]] = (int(size["width"]), int(size["height"]))
    return sizes


def output_desktop_map() -> dict[str, int]:
    """Map connector name (DP-1, ...) to the Plasma screen index showing it.

    Matched on position rather than size: Plasma reports the scaled logical
    geometry while kscreen reports physical pixels, but both agree on where a
    screen starts, and two identical monitors can only be told apart by where
    they sit.
    """
    printed = plasma_evaluate(
        "var out = [];"
        "var ds = desktops();"
        "for (var i = 0; i < ds.length; i++) {"
        "  var g = screenGeometry(ds[i].screen);"
        "  out.push(ds[i].screen + ':' + g.x + ',' + g.y);"
        "}"
        "print(out.join(';'));"
    )
    if not printed:
        return {}

    by_position: dict[tuple[int, int], int] = {}
    for entry in printed.strip().split(";"):
        if ":" not in entry:
            continue
        index, _, coords = entry.partition(":")
        x, _, y = coords.partition(",")
        try:
            by_position[(int(x), int(y))] = int(index)
        except ValueError:
            continue

    return {
        name: by_position[pos] for name, pos in output_positions().items() if pos in by_position
    }


def find_hero_art(appid: str) -> Path | None:
    """Steam's own library hero image for a game, if it has been downloaded.

    Newer clients file artwork under a content-hash directory; older entries are
    flat, and some libraries have both mid-migration. Only games whose store page
    has actually been opened have this art locally.
    """
    candidates = list((STEAM_LIBRARY_CACHE / appid).glob("**/library_hero.jpg"))
    if not candidates:
        return None
    return max(candidates, key=lambda p: p.stat().st_size)


def build_wallpaper(appid: str, width: int, height: int) -> Path | None:
    """Fit the hero art to a screen, and cache the result.

    The hero is a 1920x620 letterbox, far wider than any screen it has to fill,
    so it is laid over a blurred, darkened blow-up of itself. These are the
    screens beside the game rather than the one being played on, so the
    treatment is deliberately recessive — ambient light, not a second thing to
    look at.
    """
    source = find_hero_art(appid)
    if source is None:
        return None

    target = ART_CACHE / f"{appid}-{width}x{height}.jpg"
    if target.exists() and target.stat().st_mtime >= source.stat().st_mtime:
        return target

    try:
        from PIL import Image, ImageEnhance, ImageFilter

        with Image.open(source) as hero:
            hero = hero.convert("RGB")

            # Backdrop: cover the whole screen, then blur and darken it well
            # past the point of detail so it reads as colour, not content.
            scale = max(width / hero.width, height / hero.height)
            backdrop = hero.resize(
                (max(1, round(hero.width * scale)), max(1, round(hero.height * scale))),
                Image.LANCZOS,
            )
            left = (backdrop.width - width) // 2
            top = (backdrop.height - height) // 2
            backdrop = backdrop.crop((left, top, left + width, top + height))
            backdrop = backdrop.filter(ImageFilter.GaussianBlur(radius=max(8, width // 60)))
            backdrop = ImageEnhance.Brightness(backdrop).enhance(0.45)

            # Foreground: the art itself, full width, centred, with its top and
            # bottom edges feathered into the backdrop. Pasted hard, the join
            # reads as two visible seams across the screen.
            fg_height = max(1, round(hero.height * (width / hero.width)))
            foreground = hero.resize((width, fg_height), Image.LANCZOS)
            foreground = ImageEnhance.Brightness(foreground).enhance(0.75)

            feather = max(1, min(fg_height // 4, (height - fg_height) // 2 + fg_height // 8))
            mask = Image.new("L", (width, fg_height), 255)
            fade = Image.linear_gradient("L").resize((width, feather))
            mask.paste(fade.transpose(Image.FLIP_TOP_BOTTOM).point(lambda v: 255 - v), (0, 0))
            mask.paste(fade.point(lambda v: 255 - v), (0, fg_height - feather))

            backdrop.paste(foreground, (0, (height - fg_height) // 2), mask)

            ART_CACHE.mkdir(parents=True, exist_ok=True)
            backdrop.save(target, "JPEG", quality=90)
    except Exception:
        log.exception("could not build wallpaper for appid %s", appid)
        return None

    log.debug("built wallpaper %s", target)
    return target


class WallpaperEffect(Effect):
    """Puts the game's own artwork on the screens beside it.

    Only the wallpaper *plugin* is switched, never the previous plugin's
    settings: Plasma stores each wallpaper plugin's configuration under its own
    key, so switching away and back leaves any custom plugin configuration untouched.
    """

    name = "wallpaper"

    def __init__(self) -> None:
        # output -> (plugin id, image path) captured before anything changed
        self._saved: dict[str, tuple[str, str]] = {}

    def apply(self, game_output: str, other_outputs: list[str], appid: str) -> None:
        if not appid:
            return

        screens = output_desktop_map()
        sizes = output_sizes()
        changes: dict[int, str] = {}

        for output in other_outputs:
            screen = screens.get(output)
            size = sizes.get(output)
            if screen is None or size is None:
                log.info("no Plasma screen found for %s; leaving its wallpaper alone", output)
                continue

            wallpaper = build_wallpaper(appid, size[0], size[1])
            if wallpaper is None:
                log.info("no hero artwork for appid %s; leaving wallpapers alone", appid)
                return

            if output not in self._saved:
                self._saved[output] = self._read_wallpaper(screen)
            changes[screen] = str(wallpaper)

        if not changes:
            return

        log.info("setting game wallpaper on %s", ", ".join(sorted(other_outputs)))
        self._write_wallpapers(changes)

    def revert(self, immediate: bool = False) -> None:
        if not self._saved:
            return

        screens = output_desktop_map()
        restore: dict[int, tuple[str, str]] = {}
        for output, saved in self._saved.items():
            screen = screens.get(output)
            if screen is not None:
                restore[screen] = saved

        log.info("restoring wallpapers on %s", ", ".join(sorted(self._saved)))
        self._saved.clear()
        if restore:
            self._restore_wallpapers(restore)

    # -- Plasma scripting --------------------------------------------------

    def _read_wallpaper(self, screen: int) -> tuple[str, str]:
        printed = plasma_evaluate(
            "var ds = desktops();"
            "for (var i = 0; i < ds.length; i++) {"
            f"  if (ds[i].screen !== {screen}) continue;"
            "  var plugin = ds[i].wallpaperPlugin;"
            f"  ds[i].currentConfigGroup = ['Wallpaper', {json.dumps(IMAGE_PLUGIN)}, 'General'];"
            "  print(plugin + '\\n' + ds[i].readConfig('Image'));"
            "}"
        )
        if not printed:
            return ("", "")
        parts = printed.strip().split("\n")
        return (parts[0] if parts else "", parts[1] if len(parts) > 1 else "")

    def _write_wallpapers(self, changes: dict[int, str]) -> None:
        lines = ["var ds = desktops();", "for (var i = 0; i < ds.length; i++) {"]
        for screen, path in changes.items():
            lines.append(
                f"  if (ds[i].screen === {screen}) {{"
                f"    ds[i].wallpaperPlugin = {json.dumps(IMAGE_PLUGIN)};"
                f"    ds[i].currentConfigGroup = ['Wallpaper', {json.dumps(IMAGE_PLUGIN)}, 'General'];"
                f"    ds[i].writeConfig('Image', {json.dumps('file://' + path)});"
                f"    ds[i].writeConfig('FillMode', 2);"
                "    ds[i].reloadConfig();"
                "  }"
            )
        lines.append("}")
        plasma_evaluate("".join(lines))

    def _restore_wallpapers(self, restore: dict[int, tuple[str, str]]) -> None:
        lines = ["var ds = desktops();", "for (var i = 0; i < ds.length; i++) {"]
        for screen, (plugin, image) in restore.items():
            if not plugin:
                continue
            body = (
                f"    ds[i].currentConfigGroup = ['Wallpaper', {json.dumps(IMAGE_PLUGIN)}, 'General'];"
                f"    ds[i].writeConfig('Image', {json.dumps(image)});"
            )
            lines.append(
                f"  if (ds[i].screen === {screen}) {{"
                f"{body}"
                f"    ds[i].wallpaperPlugin = {json.dumps(plugin)};"
                "    ds[i].reloadConfig();"
                "  }"
            )
        lines.append("}")
        plasma_evaluate("".join(lines))

    def saved_state(self) -> dict | None:
        return {"wallpapers": {k: list(v) for k, v in self._saved.items()}} if self._saved else None

    def recover(self, saved: dict) -> None:
        values = saved.get("wallpapers") or {}
        if not values:
            return
        log.warning("restoring wallpapers left behind by a previous run: %s", list(values))
        self._saved = {k: (v[0], v[1]) for k, v in values.items()}
        self.revert(immediate=True)


class CompositeEffect(Effect):
    """Runs several effects as one, so dimming and wallpapers can combine."""

    def __init__(self, effects: list[Effect]):
        self._effects = effects
        self.name = "+".join(e.name for e in effects)
        self._pending: int | None = None

    # Abrupt effects land at the end of the gradual ones, not partway: the dim
    # is a single write that the compositor delivers to the monitor after a
    # delay, so "partway" is still full brightness. Waiting for it to arrive is
    # what puts the wallpaper switch in the dark.
    _INSTANT_AT = 1.0

    def apply(self, game_output: str, other_outputs: list[str], appid: str) -> None:
        self._cancel_pending()
        gradual = [e for e in self._effects if e.transition_seconds > 0]
        instant = [e for e in self._effects if e.transition_seconds <= 0]

        for effect in gradual:
            self._run(effect.apply, effect, "apply", game_output, other_outputs, appid)

        if not instant:
            return

        def run_instant() -> bool:
            self._pending = None
            for effect in instant:
                self._run(effect.apply, effect, "apply", game_output, other_outputs, appid)
            return GLib.SOURCE_REMOVE

        delay = max((e.transition_seconds for e in gradual), default=0.0) * self._INSTANT_AT
        if delay <= 0:
            run_instant()
        else:
            self._pending = GLib.timeout_add(int(delay * 1000), run_instant)

    def revert(self, immediate: bool = False) -> None:
        self._cancel_pending()
        # Reverse order: the abrupt effects undo themselves while the screens
        # are still dark, and only then do the gradual ones bring the light back.
        for effect in self._effects:
            if effect.transition_seconds <= 0:
                self._run(effect.revert, effect, "revert", immediate=immediate)
        for effect in self._effects:
            if effect.transition_seconds > 0:
                self._run(effect.revert, effect, "revert", immediate=immediate)

    def cancel_pending(self) -> None:
        if self._pending is not None:
            GLib.source_remove(self._pending)
            self._pending = None

    # Internal alias kept so apply/revert read naturally.
    _cancel_pending = cancel_pending

    @staticmethod
    def _run(call, effect: Effect, what: str, *args, **kwargs) -> None:
        try:
            call(*args, **kwargs)
        except Exception:
            log.exception("effect %s failed to %s", effect.name, what)

    def saved_state(self) -> dict | None:
        state = {}
        for effect in self._effects:
            part = effect.saved_state()
            if part:
                state[effect.name] = part
        return state or None

    def recover(self, saved: dict) -> None:
        for effect in self._effects:
            part = saved.get(effect.name)
            if part:
                effect.recover(part)


EFFECTS = {"log": LogEffect, "brightness": BrightnessEffect, "wallpaper": WallpaperEffect}


# --------------------------------------------------------------------------
# Daemon
# --------------------------------------------------------------------------


@dataclass
class TrackedWindow:
    window_id: str
    resource_class: str
    pid: int
    output: str
    fullscreen: bool
    appid: str | None = None
    normal: bool = True

    @property
    def is_game(self) -> bool:
        return self.appid is not None


@dataclass
class Daemon:
    effect: Effect
    require_fullscreen: bool = False
    # Games with a launcher (Deltarune's chapter select, Kingdom Hearts, an
    # anti-cheat bootstrapper) can close every window they own before the game
    # proper opens one. Reverting the instant the count hits zero would flash
    # the other monitors back to full brightness mid-launch, so a revert waits
    # to see whether a window comes back.
    revert_delay: float = 3.0
    # How long a game must stay on a new screen before the effect follows it.
    stage_delay: float = 1.5
    windows: dict[str, TrackedWindow] = field(default_factory=dict)
    active_output: str | None = None
    _snapshot: set[str] | None = None
    _pending_revert: int | None = None
    _pending_stage: int | None = None

    # -- state machine -----------------------------------------------------

    def game_windows(self) -> list[TrackedWindow]:
        games = [w for w in self.windows.values() if w.is_game]
        if self.require_fullscreen:
            games = [w for w in games if w.fullscreen]
        return games

    def reconcile(self) -> None:
        """Bring the applied effect in line with the current set of game windows."""
        games = self.game_windows()

        if not games:
            self._cancel_pending_stage()
            # Nothing left to decorate, so drop any effect work still queued —
            # otherwise a wallpaper scheduled moments ago lands on screens the
            # game has already left, and sits there until the revert catches up.
            self.effect.cancel_pending()
            if self.active_output is not None and self._pending_revert is None:
                if self.revert_delay > 0:
                    log.info("no game windows left; reverting in %.1fs", self.revert_delay)
                    self._pending_revert = GLib.timeout_add(
                        int(self.revert_delay * 1000), self._revert_now
                    )
                else:
                    self._revert_now()
            return

        # A game window exists again, so any revert we were waiting to perform
        # was only a gap between a launcher and the game itself.
        self._cancel_pending_revert()

        stage = self._stage(games)
        if stage is None or stage.output == self.active_output:
            self._cancel_pending_stage()
            return

        if self.active_output is None:
            # First application: nothing is in place yet, so there is nothing to
            # disturb and every reason to be prompt.
            self._commit_stage(stage.output, stage.appid or "", stage.resource_class)
            return

        # Moving an applied effect to another screen is disruptive and usually
        # spurious: games throw short-lived windows on other outputs while
        # starting and stopping — Deltarune's teardown opens one for a quarter
        # of a second — and reacting instantly drags the dim and the wallpaper
        # onto the wrong screens and back. Require the new screen to stick.
        if self._pending_stage is not None:
            return
        log.info(
            "game appears to have moved from %s to %s; confirming for %.1fs",
            self.active_output,
            stage.output,
            self.stage_delay,
        )
        self._pending_stage = GLib.timeout_add(
            int(self.stage_delay * 1000), self._confirm_stage
        )

    def _stage(self, games: list[TrackedWindow]) -> TrackedWindow | None:
        """The window that defines which screen is being played on.

        A fullscreen window wins: it is the one actually being played, rather
        than a launcher or a stray surface the game happens to still own.
        """
        if not games:
            return None
        return next((w for w in games if w.fullscreen), games[0])

    def _confirm_stage(self) -> bool:
        """Re-target only if the game is still on the screen it moved to."""
        self._pending_stage = None
        stage = self._stage(self.game_windows())
        if stage is None or stage.output == self.active_output:
            log.info("game did not stay on the new screen; leaving theater mode where it is")
            return GLib.SOURCE_REMOVE

        log.info("game moved from %s to %s; re-applying", self.active_output, stage.output)
        self.effect.revert()
        self._commit_stage(stage.output, stage.appid or "", stage.resource_class)
        return GLib.SOURCE_REMOVE

    def _commit_stage(self, output: str, appid: str, resource_class: str) -> None:
        others = sorted({o for o in self.all_outputs() if o != output})
        log.info(
            "game detected: appid=%s class=%s on %s (other outputs: %s)",
            appid,
            resource_class,
            output,
            ", ".join(others) or "none",
        )
        self.effect.apply(output, others, appid)
        self.active_output = output
        self._persist()

    def _cancel_pending_stage(self) -> None:
        if self._pending_stage is not None:
            GLib.source_remove(self._pending_stage)
            self._pending_stage = None

    def _revert_now(self, immediate: bool = False) -> bool:
        """Actually undo the effect. Also serves as the GLib timeout callback."""
        self._pending_revert = None
        if self.active_output is None:
            return GLib.SOURCE_REMOVE
        log.info("reverting")
        self.effect.revert(immediate=immediate)
        self.active_output = None
        self._persist()
        return GLib.SOURCE_REMOVE

    def _cancel_pending_revert(self) -> None:
        if self._pending_revert is None:
            return
        GLib.source_remove(self._pending_revert)
        self._pending_revert = None
        log.info("a game window returned within %.1fs; staying in theater mode", self.revert_delay)

    def all_outputs(self) -> set[str]:
        """Every output currently known, from KWin's own view of the session."""
        outputs = {w.output for w in self.windows.values() if w.output}
        outputs.update(connected_outputs())
        return outputs

    # -- crash recovery ----------------------------------------------------

    def _persist(self) -> None:
        state = self.effect.saved_state()
        try:
            if state is None:
                STATE_FILE.unlink(missing_ok=True)
                return
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            payload = {"effect": self.effect.name, "state": state}
            tmp = STATE_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(payload))
            tmp.replace(STATE_FILE)
        except OSError as exc:
            log.error("could not persist state: %s", exc)

    def recover(self) -> None:
        """Undo anything a previous run left applied when it died."""
        try:
            payload = json.loads(STATE_FILE.read_text())
        except FileNotFoundError:
            return
        except (OSError, json.JSONDecodeError) as exc:
            log.error("unreadable state file, removing: %s", exc)
            STATE_FILE.unlink(missing_ok=True)
            return

        if payload.get("effect") != self.effect.name:
            log.warning(
                "state left by effect %r but running %r; not touching it",
                payload.get("effect"),
                self.effect.name,
            )
            return

        self.effect.recover(payload.get("state") or {})
        STATE_FILE.unlink(missing_ok=True)

    # -- D-Bus methods -----------------------------------------------------

    def window_opened(self, window_id, resource_class, pid, output, fullscreen, normal="true"):
        pid = parse_int(pid)
        fullscreen = parse_bool(fullscreen)
        normal = parse_bool(normal)
        appid = steam_appid_for_window(resource_class, pid)
        window = TrackedWindow(
            window_id, resource_class, pid, output, fullscreen, appid, normal=normal
        )

        known = self.windows.get(window_id)
        self.windows[window_id] = window
        if self._snapshot is not None:
            self._snapshot.add(window_id)

        if appid and (known is None or not known.is_game):
            log.info("game window opened: appid=%s class=%s pid=%d on %s",
                     appid, resource_class, pid, output)
        else:
            log.debug(
                "window opened: class=%s pid=%d on %s normal=%s fullscreen=%s (not a game)",
                resource_class, pid, output, normal, fullscreen,
            )
        self.reconcile()

    def window_changed(self, window_id, output, fullscreen):
        window = self.windows.get(window_id)
        if window is None:
            log.debug("change for untracked window %s; ignoring", window_id)
            return
        window.output = output
        window.fullscreen = parse_bool(fullscreen)
        if window.is_game:
            log.info("game window moved: appid=%s now on %s fullscreen=%s",
                     window.appid, output, fullscreen)
        self.reconcile()

    def window_closed(self, window_id):
        window = self.windows.pop(window_id, None)
        if window and window.is_game:
            log.info("game window closed: appid=%s", window.appid)
        self.reconcile()

    def snapshot_begin(self):
        self._snapshot = set()

    def snapshot_end(self):
        if self._snapshot is None:
            return
        stale = set(self.windows) - self._snapshot
        for window_id in stale:
            window = self.windows.pop(window_id)
            log.info("dropping stale window from snapshot: class=%s", window.resource_class)
        self._snapshot = None
        if stale:
            self.reconcile()

    def status(self) -> str:
        return json.dumps(
            {
                "effect": self.effect.name,
                "active_output": self.active_output,
                "revert_pending": self._pending_revert is not None,
                "revert_delay": self.revert_delay,
                "require_fullscreen": self.require_fullscreen,
                "tracked_windows": len(self.windows),
                "games": [
                    {
                        "appid": w.appid,
                        "class": w.resource_class,
                        "pid": w.pid,
                        "output": w.output,
                        "fullscreen": w.fullscreen,
                    }
                    for w in self.windows.values()
                    if w.is_game
                ],
                "outputs": sorted(self.all_outputs()),
            },
            indent=2,
        )

    def simulate(self, appid: str, output: str) -> str:
        """Pretend a game opened, so the effect can be tested without one."""
        fake_id = f"simulated-{appid}"
        self.windows[fake_id] = TrackedWindow(
            fake_id, f"steam_app_{appid}", 0, output, True, appid
        )
        self.reconcile()
        return f"simulated game {appid} on {output}; call Clear to undo"

    def clear(self, immediate: bool = False) -> str:
        """Drop simulated windows and undo the effect now, skipping the debounce.

        Used by the test hook and on shutdown, where waiting would either
        confuse a manual test or leave the screens dimmed after exit.
        """
        # Forget every window, not just simulated ones. This is the manual
        # escape hatch, so it has to work even when the daemon wrongly believes
        # a game is still open — which is exactly when someone reaches for it.
        # The detector's next snapshot re-syncs reality and re-applies if a game
        # really is running.
        self.windows.clear()
        self._cancel_pending_revert()
        self._cancel_pending_stage()
        self.effect.cancel_pending()
        self._revert_now(immediate=immediate)
        return "cleared"


def make_handler(daemon: Daemon):
    def handle_call(conn, sender, path, iface, method, params, invocation, *_):
        try:
            args = params.unpack()
            if method == "WindowOpened":
                daemon.window_opened(*args)
            elif method == "WindowChanged":
                daemon.window_changed(*args)
            elif method == "WindowClosed":
                daemon.window_closed(*args)
            elif method == "SnapshotBegin":
                daemon.snapshot_begin()
            elif method == "SnapshotEnd":
                daemon.snapshot_end()
            elif method == "Status":
                invocation.return_value(GLib.Variant("(s)", (daemon.status(),)))
                return
            elif method == "Simulate":
                invocation.return_value(GLib.Variant("(s)", (daemon.simulate(*args),)))
                return
            elif method == "Clear":
                invocation.return_value(GLib.Variant("(s)", (daemon.clear(),)))
                return
            else:
                invocation.return_dbus_error(f"{INTERFACE}.UnknownMethod", method)
                return
            invocation.return_value(None)
        except Exception:
            # A failure handling one window must never take the daemon down and
            # leave the screens dimmed with nothing left to restore them.
            log.exception("error handling %s", method)
            try:
                invocation.return_dbus_error(f"{INTERFACE}.Failed", f"{method} failed")
            except Exception:
                pass

    return handle_call


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--effect",
        default="log",
        help="effects to apply to the other outputs, comma separated "
        f"({', '.join(sorted(EFFECTS))}); default is log, a dry run",
    )
    parser.add_argument(
        "--dim-factor",
        type=float,
        default=0.35,
        help="fraction of original brightness to dim to, for --effect brightness",
    )
    parser.add_argument(
        "--settle-seconds",
        type=float,
        default=1.5,
        help="how long a brightness change takes to reach the monitor; used to time "
        "the wallpaper switch so it lands once the screens have actually darkened",
    )
    parser.add_argument(
        "--revert-delay",
        type=float,
        default=3.0,
        help="seconds to wait before reverting, so a launcher handing off to the game "
        "does not flash the other screens (0 disables)",
    )
    parser.add_argument(
        "--stage-delay",
        type=float,
        default=1.5,
        help="how long a game must stay on a new screen before the effect follows it; "
        "guards against short-lived windows games throw on other screens while "
        "starting and stopping",
    )
    parser.add_argument(
        "--require-fullscreen",
        action="store_true",
        help="only treat a game as playing once its window is fullscreen",
    )
    parser.add_argument("--verbose", action="store_true", help="log every window event")
    args = parser.parse_args()

    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.INFO,
        format="%(levelname)s %(message)s",
        stream=sys.stderr,
    )

    if not 0.0 < args.dim_factor <= 1.0:
        parser.error("--dim-factor must be greater than 0 and at most 1")

    names = [name.strip() for name in args.effect.split(",") if name.strip()]
    unknown = [name for name in names if name not in EFFECTS]
    if unknown or not names:
        parser.error(
            f"unknown effect(s): {', '.join(unknown) or '(none given)'}; "
            f"choose from {', '.join(sorted(EFFECTS))}"
        )

    def build(name: str) -> Effect:
        if EFFECTS[name] is BrightnessEffect:
            return BrightnessEffect(
                args.dim_factor, settle_seconds=args.settle_seconds
            )
        return EFFECTS[name]()

    built = [build(name) for name in names]
    effect = built[0] if len(built) == 1 else CompositeEffect(built)

    daemon = Daemon(
        effect=effect,
        require_fullscreen=args.require_fullscreen,
        revert_delay=max(0.0, args.revert_delay),
        stage_delay=max(0.0, args.stage_delay),
    )
    daemon.recover()

    loop = GLib.MainLoop()

    def shutdown(*_):
        # Leaving the screens dimmed after the daemon exits would be the single
        # most annoying possible failure, so revert on the way out.
        log.info("shutting down; reverting any active effect")
        try:
            daemon.clear(immediate=True)
        finally:
            loop.quit()
        return GLib.SOURCE_REMOVE

    GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, shutdown)
    GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, shutdown)

    node = Gio.DBusNodeInfo.new_for_xml(INTERFACE_XML)
    registration: dict[str, int] = {}

    def on_bus_acquired(conn, name, *_):
        registration["id"] = conn.register_object_with_closures2(
            OBJECT_PATH, node.interfaces[0], make_handler(daemon), None, None
        )
        log.info("listening on %s as %s (effect: %s)", OBJECT_PATH, name, effect.name)

    def on_name_lost(*_):
        log.error("lost the bus name %s; another instance is probably running", BUS_NAME)
        loop.quit()

    Gio.bus_own_name(
        Gio.BusType.SESSION,
        BUS_NAME,
        Gio.BusNameOwnerFlags.NONE,
        on_bus_acquired,
        None,
        on_name_lost,
    )

    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
