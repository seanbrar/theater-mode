#!/usr/bin/env python3
"""Executable entrypoint for the theater-mode daemon."""

from __future__ import annotations

import os
import sys
from pathlib import Path

# Prefer repo src/ if running from a checkout, otherwise fall back to installed lib.
REPO_ROOT = Path(__file__).resolve().parent.parent
DATA_LIB = (
    Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "theater-mode" / "lib"
)

candidates = [DATA_LIB]
if (REPO_ROOT / "pyproject.toml").is_file():
    candidates.insert(0, REPO_ROOT / "src")
for candidate in candidates:
    if (candidate / "theater_mode" / "__init__.py").is_file():
        sys.path.insert(0, str(candidate))
        break

from theater_mode.cli import main

if __name__ == "__main__":
    sys.exit(main())
