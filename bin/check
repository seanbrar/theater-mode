#!/usr/bin/env bash
#
# Sanity check for unit tests, syntax, and formatting.

set -euo pipefail

REPO_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR"

# Include Homebrew in PATH if present and not already exported
if [ -d "/home/linuxbrew/.linuxbrew/bin" ]; then
    export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
fi

echo "[check] Running unit tests..."
PYTHONPATH=src python3 -m unittest discover -s tests -q

if command -v ruff >/dev/null 2>&1; then
    echo "[check] Running ruff..."
    ruff check .
    ruff format --check .
fi

echo "[check] All checks passed cleanly."
