#!/usr/bin/env bash
#
# Sanity check for unit tests, syntax, and formatting.

set -euo pipefail

die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

wait_for_jobs() {
    local label=$1 pid failed=0
    shift
    for pid in "$@"; do
        wait "$pid" || failed=1
    done
    [ "$failed" -eq 0 ] || die "$label failed"
}

# Report the binary that actually resolved to make host tool shadowing visible.
need() {
    local name=$1 path version
    path="$(command -v "$name" 2>/dev/null)" \
        || die "$name is required; see CONTRIBUTING.md for development setup"
    version="$("$name" --version 2>&1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1 || true)"
    printf '  %-11s %-9s %s\n' "$name" "${version:-unknown}" "$path"
}

REPO_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR"

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# Sanitizers need the plain allocator, so _FORTIFY_SOURCE is left off these builds only.
SAN_FLAGS=(-std=gnu17 -O0 -g "-fsanitize=address,undefined" -fno-omit-frame-pointer -Wall -Wextra -Werror)

echo "[check] Toolchain:"
need cc
CC_BIN="$(command -v cc)"
need make
need pkg-config
need python3
need node
need readelf
need shellcheck
need ruff

echo "[check] Building the Wayland dimmer and artwork helper..."
make -C src/theater_mode/dimmer clean >/dev/null
make -C src/theater_mode/art clean >/dev/null
# These flags are hostile on purpose. The Makefile override has to come after them: if it
# does not, -O0 survives and glibc warns that fortification needs optimization; if the -U
# is dropped, the -D warns about redefinition. -Werror turns either into a build failure.
make -C src/theater_mode/dimmer \
    CFLAGS="-O0 -D_FORTIFY_SOURCE=0 -Wall -Wextra -pedantic -Werror" >/dev/null &
dimmer_pid=$!
make -C src/theater_mode/art \
    CFLAGS="-O0 -D_FORTIFY_SOURCE=0 -Wall -Wextra -pedantic -Werror" >/dev/null &
art_pid=$!
wait_for_jobs "native helper build" "$dimmer_pid" "$art_pid"

echo "[check] Verifying helper binaries report the package version..."
PKG_VERSION="$(sed -n 's/^__version__ = "\(.*\)"/\1/p' src/theater_mode/__init__.py)"
[ -n "$PKG_VERSION" ] || die "could not read __version__ from src/theater_mode/__init__.py"
DIMMER_VERSION="$(src/theater_mode/dimmer/theater-dimmer --version | awk '{print $2}')"
[ "$PKG_VERSION" = "$DIMMER_VERSION" ] \
    || die "theater-dimmer reports $DIMMER_VERSION but the package is $PKG_VERSION"
ART_VERSION="$(src/theater_mode/art/theater-art --version | awk '{print $2}')"
[ "$PKG_VERSION" = "$ART_VERSION" ] \
    || die "theater-art reports $ART_VERSION but the package is $PKG_VERSION"

echo "[check] Verifying the helpers kept their hardening flags..."
for binary in src/theater_mode/dimmer/theater-dimmer src/theater_mode/art/theater-art; do
    readelf -h "$binary" | grep -q 'Type:.*DYN' \
        || die "$binary is not position-independent; -fPIE/-pie did not survive"
    readelf -d "$binary" | grep -q 'BIND_NOW' \
        || die "$binary was not linked with -z now; LDFLAGS did not survive"
    readelf --dyn-syms -W "$binary" | grep -qE '__[[:alnum:]_]+_chk@' \
        || die "$binary has no fortified libc calls; _FORTIFY_SOURCE did not survive"
    readelf --dyn-syms -W "$binary" | grep -q '__stack_chk_fail@' \
        || die "$binary has no stack canary checks; stack protection did not survive"
done

echo "[check] Verifying the release ABI floor..."
./bin/check-abi-floor src/theater_mode/dimmer/theater-dimmer
./bin/check-abi-floor src/theater_mode/art/theater-art 2.35 "libc.so.6 libm.so.6"

echo "[check] Assembling the release archive..."
if ! ./bin/make-release \
    --dimmer-bin src/theater_mode/dimmer/theater-dimmer \
    --art-bin src/theater_mode/art/theater-art \
    --outdir "$WORK/release" > "$WORK/make-release.log" 2>&1; then
    cat "$WORK/make-release.log" >&2
    die "release archive assembly failed"
fi

echo "[check] Building the native helpers and unit tests with ASan and UBSan..."
"$CC_BIN" "${SAN_FLAGS[@]}" -Isrc/theater_mode/art -DTHEATER_ART_VERSION='"test"' \
    tests/art/test_pipeline.c -lm -o "$WORK/test_pipeline" &
test_pid=$!
"$CC_BIN" "${SAN_FLAGS[@]}" -Isrc/theater_mode/art -DTHEATER_ART_VERSION="\"$PKG_VERSION\"" \
    src/theater_mode/art/main.c src/theater_mode/art/pipeline.c -lm -o "$WORK/theater-art-asan" &
art_asan_pid=$!
"$CC_BIN" "${SAN_FLAGS[@]}" -Isrc/theater_mode/dimmer -DTHEATER_DIMMER_VERSION="\"$PKG_VERSION\"" \
    tests/dimmer/test_parser.c src/theater_mode/dimmer/wlr-layer-shell-unstable-v1-protocol.c \
    src/theater_mode/dimmer/viewporter-protocol.c src/theater_mode/dimmer/single-pixel-buffer-v1-protocol.c \
    src/theater_mode/dimmer/alpha-modifier-v1-protocol.c src/theater_mode/dimmer/xdg-shell-protocol.c \
    -lwayland-client -lm -o "$WORK/test_dimmer_parser" &
dimmer_test_pid=$!
wait_for_jobs "sanitizer build" "$test_pid" "$art_asan_pid" "$dimmer_test_pid"

echo "[check] Running dimmer and artwork unit tests..."
ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1 \
    "$WORK/test_dimmer_parser"
ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1 \
    "$WORK/test_pipeline" tests/fixtures/artwork_reference

echo "[check] Running artwork oracle visual verification (instrumented)..."
ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1 \
    THEATER_ART_BIN="$WORK/theater-art-asan" python3 tests/verify_oracle.py

echo "[check] Verifying config.reference.toml matches the schema..."
PYTHONPATH="$REPO_DIR/src" python3 -c '
import sys
from pathlib import Path
from theater_mode.config import generate_reference_config
current = Path("config.reference.toml").read_text(encoding="utf-8")
if current != generate_reference_config():
    sys.exit("config.reference.toml is stale; regenerate it from the schema")
'

echo "[check] Checking the KWin script and its metadata..."
node --check kwin/theater-detect/contents/code/main.js
node tests/test_kwin_detector.js
python3 -c 'import json; json.load(open("kwin/theater-detect/metadata.json"))'

echo "[check] Checking GitHub Actions workflow YAML syntax..."
# Syntax only, deliberately not Actions schema validation: a bad indent silently disabling
# every workflow is the failure this catches, and PyYAML must be present or it catches nothing.
python3 -c '
import glob, sys
import yaml
for f in sorted(glob.glob(".github/workflows/*.yml")):
    with open(f, encoding="utf-8") as fh:
        try:
            yaml.safe_load(fh)
        except yaml.YAMLError as exc:
            sys.exit(f"{f}: {exc}")
'

echo "[check] Running ShellCheck..."
shellcheck install.sh get.sh bin/check bin/make-release bin/check-abi-floor \
    tools/nested/nested-session.sh tools/nested/session-inner.sh tools/vm/vm.sh

echo "[check] Running unit tests..."
python3 -m unittest discover -s tests -t . -q

echo "[check] Running Ruff..."
ruff check .
ruff format --check .

echo "[check] All checks passed cleanly."
