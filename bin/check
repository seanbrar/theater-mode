#!/usr/bin/env bash
#
# Sanity check for unit tests, syntax, and formatting.

set -euo pipefail

die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

REPO_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR"

echo "[check] Building the Wayland dimmer..."
make -C src/theater_mode/dimmer clean >/dev/null
make -C src/theater_mode/dimmer CFLAGS="-O2 -Wall -Wextra -pedantic -Werror" >/dev/null

echo "[check] Verifying config.reference.toml matches the schema..."
PYTHONPATH="$REPO_DIR/src" python3 -c '
import sys
from pathlib import Path
from theater_mode.config import generate_reference_config
current = Path("config.reference.toml").read_text(encoding="utf-8")
if current != generate_reference_config():
    sys.exit("config.reference.toml is stale; regenerate it from the schema")
'

echo "[check] Running unit tests..."
python3 -m unittest discover -s tests -t . -q

# Prefer system ruff; fall back to uvx or uv tool run.
if command -v ruff >/dev/null 2>&1; then
    RUFF=(ruff)
elif command -v uvx >/dev/null 2>&1; then
    RUFF=(uvx ruff)
elif command -v uv >/dev/null 2>&1; then
    RUFF=(uv tool run ruff)
else
    RUFF=()
fi

if [ ${#RUFF[@]} -gt 0 ]; then
    echo "[check] Running ruff (${RUFF[*]})..."
    "${RUFF[@]}" check .
    "${RUFF[@]}" format --check .
else
    echo "[check] Build, config, and tests passed." >&2
    die "ruff not run: no 'ruff' and no 'uv' on PATH. Install either so lint and formatting are checked."
fi

echo "[check] All checks passed cleanly."
