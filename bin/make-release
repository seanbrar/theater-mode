#!/usr/bin/env bash
#
# Assemble a release tarball around already-compiled helper binaries.
#
#   bin/make-release --dimmer-bin path/to/theater-dimmer --art-bin path/to/theater-art [--outdir dist]
#
# The helper sources are kept in the archive so a user whose glibc is too old for the
# prebuilt helpers can still run ./install.sh --build without cloning anything.

set -euo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

DIMMER=""
ART=""
OUTDIR="$REPO/dist"
while [ $# -gt 0 ]; do
    case "$1" in
        --dimmer-bin=*) DIMMER="${1#*=}" ;;
        --dimmer-bin)   [ $# -ge 2 ] || die "--dimmer-bin requires a path"; DIMMER="$2"; shift ;;
        --art-bin=*)    ART="${1#*=}" ;;
        --art-bin)      [ $# -ge 2 ] || die "--art-bin requires a path"; ART="$2"; shift ;;
        --outdir=*)     OUTDIR="${1#*=}" ;;
        --outdir)       [ $# -ge 2 ] || die "--outdir requires a path"; OUTDIR="$2"; shift ;;
        -h|--help)      sed -n '3,8p' "$0"; exit 0 ;;
        *)              die "unknown option: $1" ;;
    esac
    shift
done

[ -n "$DIMMER" ] || die "--dimmer-bin is required"
[ -x "$DIMMER" ] || die "not an executable file: $DIMMER"
[ -n "$ART" ] || die "--art-bin is required"
[ -x "$ART" ] || die "not an executable file: $ART"

VERSION="$(sed -n 's/^__version__ = "\(.*\)"/\1/p' src/theater_mode/__init__.py)"
[ -n "$VERSION" ] || die "could not read __version__ from src/theater_mode/__init__.py"

STAMP="$("$DIMMER" --version 2>/dev/null | awk '{print $2}')" \
    || die "$DIMMER --version failed; it is not a usable theater-dimmer"
[ "$STAMP" = "$VERSION" ] \
    || die "dimmer helper reports $STAMP but this tree is $VERSION; rebuild the helper"

ART_STAMP="$("$ART" --version 2>/dev/null | awk '{print $2}')" \
    || die "$ART --version failed; it is not a usable theater-art"
[ "$ART_STAMP" = "$VERSION" ] \
    || die "art helper reports $ART_STAMP but this tree is $VERSION; rebuild the helper"

ARCH="$(uname -m)"
NAME="theater-mode-v${VERSION}-linux-${ARCH}"
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
ROOT="$STAGE/$NAME"

mkdir -p "$ROOT"

# Packaging must not read the wall clock.
# tar takes this as --mtime below. Nothing downstream reads the variable; no export.
if [ -z "${SOURCE_DATE_EPOCH:-}" ]; then
    SOURCE_DATE_EPOCH="$(git log -1 --format=%ct HEAD)" \
        || die "could not read the commit timestamp; refusing to build an unreproducible archive"
fi

# Development-only paths are excluded during extraction rather than deleted afterward
# so the ~30 MB reference corpus is never written to disk just to be removed.
#
# Excluding pyproject.toml is functional: bin/theater-mode{,d} use its presence to detect
# a source checkout. Development scripts under bin/ are enumerated individually because
# Git :(exclude) pathspecs match exact file paths, not name prefixes.
DEV_ONLY=(tests tools .github bin/check bin/check-abi-floor bin/make-release get.sh
          pyproject.toml CONTRIBUTING.md .gitignore .gitattributes distrobox.ini)
EXCLUDE=()
for path in "${DEV_ONLY[@]}"; do EXCLUDE+=(":(exclude)$path"); done

# Read current contents for files known to Git. New files must be staged first, which
# prevents unrelated local scratch files from leaking into an archive.
if ! git diff-index --quiet HEAD -- 2>/dev/null; then
    printf '\033[33mwarning:\033[0m working tree has uncommitted edits; archive will include them\n' >&2
fi
git ls-files --cached -z -- . "${EXCLUDE[@]}" \
    | tar --null -T - -cf - \
    | tar -x -C "$ROOT"

# A release ships the runtime tree and nothing else. Anything new and dev-only at the top
# level must be added to DEV_ONLY above, so fail loudly rather than shipping it by
# omission. Uses find rather than a glob so a stray dotfile cannot slip through unseen.
EXPECTED_TOP="LICENSE README.md bin config.reference.toml install.sh kwin src systemd"
ACTUAL_TOP="$(find "$ROOT" -mindepth 1 -maxdepth 1 -printf '%f\n' | LC_ALL=C sort | tr '\n' ' ' | sed 's/ $//')"
[ "$ACTUAL_TOP" = "$EXPECTED_TOP" ] \
    || die "unexpected release layout.
  got:      $ACTUAL_TOP
  expected: $EXPECTED_TOP
  Add new development-only files to DEV_ONLY in bin/make-release, or to the expected list."

install -m 0755 "$DIMMER" "$ROOT/bin/theater-dimmer"
install -m 0755 "$ART" "$ROOT/bin/theater-art"

mkdir -p "$OUTDIR"
TARBALL="$OUTDIR/${NAME}.tar.gz"

# Git applies the umask when it writes the working tree. Without --mode the same commit
# archived under umask 077 and under umask 022 produces two different checksums.
tar --sort=name --owner=0 --group=0 --numeric-owner \
    --mode='go-w,go+rX' --mtime="@$SOURCE_DATE_EPOCH" \
    -czf "$TARBALL" -C "$STAGE" "$NAME"

( cd "$OUTDIR" && sha256sum "$(basename "$TARBALL")" > "${NAME}.tar.gz.sha256" )

printf 'built %s\n' "$TARBALL"
printf '  version %s, dimmer %s, art %s, arch %s\n' "$VERSION" "$STAMP" "$ART_STAMP" "$ARCH"
printf '  %s\n' "$(cat "$OUTDIR/${NAME}.tar.gz.sha256")"
