[Unit]
Description=Theater mode daemon (dims secondary screens while a Steam game is active)
PartOf=graphical-session.target
After=plasma-workspace.target

[Service]
Type=simple
# All settings live in ~/.config/theater-mode/config.toml.
# Inspect or change them with `theater-mode config show` / `theater-mode config set`.
# @DAEMON@ is rendered by install.sh with the installed daemon path.
ExecStart=/usr/bin/env -- "@DAEMON@"
Restart=on-failure
RestartSec=5
Slice=session.slice

[Install]
WantedBy=graphical-session.target
